{
  "name": "cambridge-pseudocode-language-server",
  "version": "0.1.0",
  "private": true,
  "description": "Language server for Cambridge 9618 pseudocode (parsing, analysis, LSP features).",
  "main": "out/server.js",
  "bin": {
    "cambridge-pseudocode-language-server": "out/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test ../out-test/server/test/*.test.js",
    "start": "node out/server.js --stdio"
  },
  "dependencies": {
    "vscode-languageserver": "~9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "~5.9.0"
  }
}
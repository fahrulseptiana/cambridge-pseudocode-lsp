// Cambridge 9618 Pseudocode — showcase file.
// Covers every construct from the Pseudocode Guide for Teachers (exams 2026).

// --- constants & variables ------------------------------------------------

CONSTANT HourlyRate = 6.50
CONSTANT DefaultText = "N/A"

DECLARE Counter : INTEGER
DECLARE TotalToPay : REAL
DECLARE GameOver : BOOLEAN
DECLARE PlayerName : STRING
DECLARE Initial : CHAR
DECLARE StudentNames : ARRAY[1:30] OF STRING
DECLARE NoughtsAndCrosses : ARRAY[1:3,1:3] OF CHAR
DECLARE Score : INTEGER
DECLARE Password : STRING
DECLARE Number : INTEGER
DECLARE Guess : INTEGER

// --- user-defined data types ----------------------------------------------

TYPE Season = (Spring, Summer, Autumn, Winter)
TYPE TIntPointer = ^INTEGER
TYPE LetterSet = SET OF CHAR
DEFINE Vowels ('A', 'E', 'I', 'O', 'U') : LetterSet

TYPE StudentRecord
  DECLARE LastName : STRING
  DECLARE FirstName : STRING
  DECLARE DateOfBirth : DATE
  DECLARE YearGroup : INTEGER
  DECLARE FormGroup : CHAR
ENDTYPE

// --- procedures -----------------------------------------------------------

PROCEDURE Swap(BYREF X : INTEGER, Y : INTEGER)
  Temp ← X // no DECLARE shown - the LSP hints about this (good practice per §2.4)
  X ← Y
  Y ← Temp
ENDPROCEDURE

PROCEDURE Greet(Name : STRING)
  OUTPUT "Hello, ", Name
ENDPROCEDURE

// --- functions ------------------------------------------------------------

FUNCTION Max(Number1 : INTEGER, Number2 : INTEGER) RETURNS INTEGER
  IF Number1 > Number2 THEN
    RETURN Number1
  ELSE
    RETURN Number2
  ENDIF
ENDFUNCTION

FUNCTION TitleCase(ThisString : STRING) RETURNS STRING
  RETURN UCASE(MID(ThisString, 1, 1)) & MID(ThisString, 2, LENGTH(ThisString) - 1)
ENDFUNCTION

// --- selection ------------------------------------------------------------

INPUT Score
IF Score >= 10 THEN
  OUTPUT "Pass"
ELSE
  OUTPUT TitleCase(DefaultText)
ENDIF

CASE OF Score
  1 TO 4 : OUTPUT "low"
  5 TO 9 : OUTPUT "mid"
  10     : OUTPUT "exactly ten"
  OTHERWISE : OUTPUT "high"
ENDCASE

// --- iteration ------------------------------------------------------------

FOR Index ← 1 TO 30
  StudentNames[Index] ← "unsorted"
NEXT Index

FOR Row ← 1 TO 3 STEP 1
  FOR Column ← 1 TO 3
    NoughtsAndCrosses[Row, Column] ← 'X'
  NEXT Column
NEXT Row

REPEAT
  INPUT Password
UNTIL Password = "Secret"

WHILE Number > 9
  Number ← Number - 9
ENDWHILE

// --- strings and files ----------------------------------------------------

DECLARE LineOfText : STRING
OPENFILE "FileA.txt" FOR READ
OPENFILE "FileB.txt" FOR WRITE
WHILE NOT EOF("FileA.txt")
  READFILE "FileA.txt", LineOfText
  OUTPUT MID(LineOfText, 1, INT(LENGTH(LineOfText) / 2))
ENDWHILE
CLOSEFILE "FileA.txt"
CLOSEFILE "FileB.txt"

// --- object-oriented programming ------------------------------------------

CLASS Pet
  PRIVATE Name : STRING
  PUBLIC PROCEDURE NEW(GivenName : STRING)
    Name ← GivenName
  ENDPROCEDURE
  PUBLIC FUNCTION GetName() RETURNS STRING
    RETURN Name
  ENDFUNCTION
ENDCLASS

CLASS Cat INHERITS Pet
  PRIVATE Breed : STRING
  PUBLIC PROCEDURE NEW(GivenName : STRING, GivenBreed : STRING)
    SUPER.NEW(GivenName)
    Breed ← GivenBreed
  ENDPROCEDURE
ENDCLASS

DECLARE MyCat : Cat
MyCat ← NEW Cat("Kitty", "Shorthaired")
OUTPUT MyCat.GetName()

// --- a little game loop ---------------------------------------------------

DECLARE Lives : INTEGER
Lives ← 3
WHILE Lives > 0
  INPUT Guess
  IF Guess = RAND(10) THEN
    OUTPUT "You win!"
    Lives ← 0
  ELSE
    CALL Greet("Computer")
    Lives ← Lives DIV 2
  ENDIF
ENDWHILE